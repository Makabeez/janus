# Chain — defaults to Rome Hadrian (200010), resolved from @rome-protocol/registry.
# Override the RPCs only if you have your own (e.g. a private Solana RPC).
# CHAIN_ID=200010
PROXY_URL=
SOLANA_RPC=

# Deployer + keeper (a MetaMask-style key, TESTNET ONLY). Needs ~1 USDC of Rome gas on
# Hadrian: deploy + a day of lock/settle calls. Bridge test USDC in; there is no faucet.
ROME_EVM_KEY=0xYOUR_EVM_PRIVATE_KEY

# Solana-lane key, only for `npm run demo` (JSON secret-key array from solana-keygen).
# Needs ~0.3 devnet USDC + 0.02 devnet SOL.
ROME_SOLANA_KEY=[1,2,3]

# Round parameters (defaults shown). TOLERANCE must be < INTERVAL.
# INTERVAL_SEC=1800
# TOLERANCE_SEC=600
# MIN_BET=100000        # 0.1 wUSDC (6 decimals)
# FEE_BPS=100           # 1%
# TREASURY=             # defaults to the deployer

# Set after `npm run deploy`.
JANUS_ADDRESS=
